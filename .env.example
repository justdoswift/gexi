# magpie 网关部署配置
# 这个文件只在本机和服务器的部署目录里存在，不进仓库。
# 复制成 .env 后把值填上：cp .env.example .env

# ── 服务器 ────────────────────────────────────────────────
# 部署目标，ssh 用
DEPLOY_HOST=49.232.40.224
DEPLOY_USER=root
# ssh 端口
DEPLOY_PORT=22
# ssh 登录方式，二选一：
#   1) 密码：填 DEPLOY_PASSWORD（需要服务器装了 sshpass）
#   2) 密钥：填 DEPLOY_KEY 指向私钥文件，或把公钥装到服务器的 authorized_keys
DEPLOY_PASSWORD=
DEPLOY_KEY=
# 服务器上的部署目录
DEPLOY_PATH=/opt/magpie

# ── 域名与 TLS ────────────────────────────────────────────
# magpie 的对外地址。DNS 的 A 记录要先指向 DEPLOY_HOST，
# 否则 Caddy 签不出证书。
MAGPIE_DOMAIN=magpie.shunji.online
# 证书邮箱，Let's Encrypt 到期提醒用
ACME_EMAIL=

# ── magpie 容器 ───────────────────────────────────────────
# Web 界面的 key，16 个字符以上，只允许字母数字和 - . _ ~
# 生成：openssl rand -hex 16
# 不设的话每次重启都会变，浏览器要重新登录。
MAGPIE_WEB_KEY=

# 其他机器访问网关用的地址，反代后面就是 https 的域名
MAGPIE_PUBLIC_URL=https://magpie.shunji.online

# 允许访问的来源 IP 或 CIDR，逗号分隔。
# 留空 = 所有地址都能访问（各自仍需网关密钥）。
# 公网机器建议填上，比如家里的出口 IP。
MAGPIE_ALLOW_IPS=

# ── 端口 ──────────────────────────────────────────────────
# 3425 是网关，3430 是 Web 界面（也响应 /v1，反代只转这一个）
MAGPIE_GATEWAY_PORT=3425
MAGPIE_WEB_PORT=3430

# ── 网关密钥 ──────────────────────────────────────────────
# 给每个客户端生成一个，在 Web 界面 网关 → 网关密钥 里加，
# 或容器里：docker exec -it magpie magpie gateway-key add "Laptop"
# 生成后形如 sk-magpie-key-…，填到 Perch / amp 的 BYOK 里。
# 这里只是记一下名字，真正的密钥在 magpie 的 /config 里。
MAGPIE_KEY_PERCH=
MAGPIE_KEY_AMP=
